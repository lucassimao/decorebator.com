# Development defaults (do not use for production OTA)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Test User Credentials (for development only)
EXPO_PUBLIC_TEST_USER_EMAIL=test@example.com
EXPO_PUBLIC_TEST_USER_PASSWORD=test123

# PostHog Analytics (dev key)
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-api-key-here
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Monitoring (dev)
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# RevenueCat Configuration (dev)
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-revenuecat-ios-api-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-revenuecat-android-api-key
