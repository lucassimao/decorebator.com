{
  "name": "decorebator",
  "main": "expo-router/entry",
  "version": "1.0.3",
  "scripts": {
    "start": "expo start -gc",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "prepare": "husky",
    "expo:update": "expo install --fix",
    "android-emulator": "$ANDROID_SDK_ROOT/emulator/emulator -avd Galaxy_S25_Ultra_6_9_inch -gpu guest",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "typecheck": "npx tsc --noEmit",
    "typecheck:watch": "npx tsc --noEmit --watch",
    "update:local": "eas update --clear-cache",
    "update:prod": "eas update --environment production --clear-cache --branch production",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:android:local": "eas build --platform android --profile production --local",
    "build:all": "eas build --platform all --profile production",
    "build:preview": "eas build --platform all --profile preview",
    "submit:ios": "eas submit --platform ios",
    "submit:android": "eas submit --platform android",
    "submit:all": "eas submit --platform all",
    "version:patch": "node -e \"const fs=require('fs'); const semver=require('semver'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const newVer=semver.inc(pkg.version,'patch'); pkg.version=newVer; fs.writeFileSync('package.json',JSON.stringify(pkg,null,2)); console.log('Updated to',newVer);\" && npm run version:sync",
    "version:minor": "node -e \"const fs=require('fs'); const semver=require('semver'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const newVer=semver.inc(pkg.version,'minor'); pkg.version=newVer; fs.writeFileSync('package.json',JSON.stringify(pkg,null,2)); console.log('Updated to',newVer);\" && npm run version:sync",
    "version:major": "node -e \"const fs=require('fs'); const semver=require('semver'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const newVer=semver.inc(pkg.version,'major'); pkg.version=newVer; fs.writeFileSync('package.json',JSON.stringify(pkg,null,2)); console.log('Updated to',newVer);\" && npm run version:sync",
    "version:sync": "node -e \"const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); const ver=pkg.version; const app=JSON.parse(fs.readFileSync('app.json','utf8')); app.expo.version=ver; app.expo.runtimeVersion=ver; fs.writeFileSync('app.json',JSON.stringify(app,null,2)); const iosPlist=fs.readFileSync('ios/decorebator/Info.plist','utf8'); const updatedPlist=iosPlist.replace(/<key>CFBundleShortVersionString<\\/key>\\s*<string>[^<]+<\\/string>/,'<key>CFBundleShortVersionString</key>\\n    <string>'+ver+'</string>'); fs.writeFileSync('ios/decorebator/Info.plist',updatedPlist); const gradlePath='android/app/build.gradle'; const gradle=fs.readFileSync(gradlePath,'utf8'); const updatedGradle=gradle.replace(/versionName \\\"[^\\\"]+\\\"/,'versionName \\\"'+ver+'\\\"'); fs.writeFileSync(gradlePath,updatedGradle); console.log('Synced version',ver,'to all platforms');\""
  },
  "prepare": "cd .. && husky mobile/.husky",
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/utils/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-purchases|date-fns|date-fns-tz)"
    ]
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^12.0.0",
    "@expo/vector-icons": "^14.0.2",
    "@hookform/resolvers": "^3.4.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/native": "^7.0.14",
    "@sentry/react-native": "~6.14.0",
    "@tanstack/react-query": "^5.36.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "expo": "53.0.22",
    "expo-application": "~6.1.5",
    "expo-audio": "~0.4.9",
    "expo-auth-session": "~6.2.1",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.10",
    "expo-font": "~13.3.1",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-mail-composer": "~14.1.6",
    "expo-notifications": "~0.31.4",
    "expo-router": "~5.1.6",
    "expo-secure-store": "~14.2.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-updates": "~0.28.17",
    "expo-web-browser": "~14.2.0",
    "i18next": "^25.2.1",
    "install": "^0.13.0",
    "lottie-react-native": "7.2.2",
    "npm": "^10.7.0",
    "posthog-react-native": "^3.16.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.51.4",
    "react-i18next": "^15.5.2",
    "react-native": "0.79.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-incall-manager": "^4.2.1",
    "react-native-paper": "^5.14.5",
    "react-native-purchases": "^8.11.6",
    "react-native-purchases-ui": "^8.11.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-vector-icons": "^10.1.0",
    "react-native-web": "^0.20.0",
    "react-native-webrtc": "^124.0.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@tanstack/eslint-plugin-query": "^5.35.6",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "@types/react-native-vector-icons": "^6.4.18",
    "eslint-config-expo": "~9.2.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.0.11",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.10",
    "lint-staged": "^15.2.5",
    "prettier": "3.2.5",
    "semver": "^7.7.2",
    "typescript": "~5.8.3"
  },
  "private": true,
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447"
}
