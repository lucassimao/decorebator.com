{
  "cli": {
    "version": ">= 16.7.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "store-test": {
      "channel": "store-test",
      "environment": "preview",
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "android": {
        "autoIncrement": "versionCode"
      }
    },
    "production": {
      "channel": "production",
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "android": {
        "autoIncrement": "versionCode"
      }
    }
  },
  "submit": {
    "store-test": {
      "ios": {
        "ascAppId": "6749329064"
      },
      "android": {
        "serviceAccountKeyPath": "./decorebator-465316-0520ea65e130.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6749329064"
      },
      "android": {
        "serviceAccountKeyPath": "./decorebator-465316-0520ea65e130.json",
        "track": "production"
      }
    }
  }
}
