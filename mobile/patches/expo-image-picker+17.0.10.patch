+package expo.modules.imagepicker.exporters
+
+import java.io.File
+import java.io.FileOutputStream
+import java.io.InputStream
+
+internal object ProfileImagePickerBoundedCopy {
+  const val MAX_BYTES = 25L * 1024L * 1024L
+  private const val STALE_MILLIS = 60L * 60L * 1000L
+  private const val SWEEP_LIMIT = 32
+
+  fun copy(input: InputStream, output: File) {
+    sweepStale(output.parentFile)
+    try {
+      FileOutputStream(output).use { target ->
+        val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+        var copied = 0L
+        while (true) {
+          val count = input.read(buffer)
+          if (count < 0) break
+          if (count == 0) continue
+          copied += count
+          require(copied <= MAX_BYTES) { "Image picker source is too large" }
+          target.write(buffer, 0, count)
+        }
+        require(copied > 0L) { "Image picker source is empty" }
+      }
+    } catch (error: Throwable) {
+      output.delete()
+      throw error
+    }
+  }
+
+  internal fun sweepStale(directory: File?, nowMillis: Long = System.currentTimeMillis()): Int {
+    val stale = directory?.listFiles()?.asSequence()
+      ?.filter {
+        it.isFile && it.name.startsWith("profile-picker-source-") &&
+          nowMillis - it.lastModified() >= STALE_MILLIS
+      }
+      ?.sortedBy { it.lastModified() }
+      ?.take(SWEEP_LIMIT)
+      ?.toList()
+      .orEmpty()
+    return stale.count { it.delete() || !it.exists() }
+  }
+}
