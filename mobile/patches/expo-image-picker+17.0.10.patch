@@ -0,0 +1,63 @@
+// Local safety patch: keep attacker-controlled gallery files bounded before
+// ImageIO or UIKit receives them. See patches/expo-image-picker+17.0.10.patch.
+import Foundation
+
+enum ProfileImagePickerBoundedCopyError: Error {
+  case invalid
+}
+
+enum ProfileImagePickerBoundedCopy {
+  static let maxBytes = 25 * 1024 * 1024
+  private static let staleAge: TimeInterval = 60 * 60
+  private static let sweepLimit = 32
+
+  static func copy(from sourceURL: URL, to targetURL: URL) throws {
+    sweepStale(in: targetURL.deletingLastPathComponent())
+    guard FileManager.default.createFile(atPath: targetURL.path, contents: nil) else {
+      throw ProfileImagePickerBoundedCopyError.invalid
+    }
+    do {
+      let input = try FileHandle(forReadingFrom: sourceURL)
+      let output = try FileHandle(forWritingTo: targetURL)
+      defer {
+        try? input.close()
+        try? output.close()
+      }
+      var copied = 0
+      while let chunk = try input.read(upToCount: 8192), !chunk.isEmpty {
+        copied += chunk.count
+        guard copied <= maxBytes else {
+          throw ProfileImagePickerBoundedCopyError.invalid
+        }
+        try output.write(contentsOf: chunk)
+      }
+      guard copied > 0 else {
+        throw ProfileImagePickerBoundedCopyError.invalid
+      }
+    } catch {
+      try? FileManager.default.removeItem(at: targetURL)
+      throw error
+    }
+  }
+
+  @discardableResult
+  static func sweepStale(in directory: URL, now: Date = Date()) -> Int {
+    let keys: Set<URLResourceKey> = [.contentModificationDateKey, .isRegularFileKey]
+    let candidates = (try? FileManager.default.contentsOfDirectory(
+      at: directory,
+      includingPropertiesForKeys: Array(keys),
+      options: [.skipsHiddenFiles]
+    )) ?? []
+    let stale = candidates.compactMap { url -> (URL, Date)? in
+      guard url.lastPathComponent.hasPrefix("profile-picker-source-"),
+            let values = try? url.resourceValues(forKeys: keys),
+            values.isRegularFile == true,
+            let modified = values.contentModificationDate,
+            now.timeIntervalSince(modified) >= staleAge else { return nil }
+      return (url, modified)
+    }.sorted { $0.1 < $1.1 }.prefix(sweepLimit)
+    return stale.reduce(into: 0) { removed, candidate in
+      if (try? FileManager.default.removeItem(at: candidate.0)) != nil { removed += 1 }
+    }
+  }
+}
