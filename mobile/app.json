{
  "expo": {
    "name": "decorebator",
    "slug": "decorebator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "decorebator",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.lsimaocosta.decorebator",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSMicrophoneUsageDescription": "This app uses audio features for pronunciation practice and voice input.",
        "NSPhotoLibraryUsageDescription": "This app accesses your photos to let you set your profile picture.",
        "CFBundleDisplayName": "Decorebator",
        "LSApplicationCategoryType": "public.app-category.education"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "package": "com.lsimaocosta.decorebator"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-secure-store",
      "expo-mail-composer",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF7B54",
          "androidMode": "default",
          "androidCollapsedTitle": "#{unread_notifications} new notifications"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you set your profile picture."
        }
      ],
      "expo-localization",
      "expo-web-browser",
  [
      "@sentry/react-native/expo",
      {
        "url": "https://sentry.io/",
        "project": "decorebator-mobile",
        "organization": "lucas-apps"
      }
    ]    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "882f0434-5dcf-448c-92ac-47e70c9a8d84"
      }
    },
    "owner": "lsimaocosta",
    "runtimeVersion": {"policy":"appVersion"},
    "updates": {
      "url": "https://u.expo.dev/882f0434-5dcf-448c-92ac-47e70c9a8d84",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0  
    }
  }
}
