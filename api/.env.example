# Database Configuration (POSTGRES_* are required for Docker)
# DATABASE_URL should point to the direct database server (used by workers).
DATABASE_URL=postgresql://user:pass@localhost:5432/decorebator?sslmode=disable
# PGBOUNCER_DATABASE_URL is optional and used by the API server when set.
PGBOUNCER_DATABASE_URL=
POSTGRES_USER=decorebator
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=decorebator
POSTGRES_PORT=5432

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_BUCKET=decorebator

# JWT Configuration
# Generate at least 32 random bytes; startup rejects missing, short, or placeholder keys.
JWT_KEY=

# Password-reset link encryption. Generate exactly 32 random bytes; startup
# rejects missing, malformed, or placeholder keys.
RESET_PASSWORD_PRIVATE_KEY=

# Email Configuration (Resend)
# Required and non-placeholder in production; production also requires
# DISABLE_EMAILS=false because signup activation depends on this channel.
RESEND_API_KEY=your_resend_api_key
RESEND_AUDIENCE_ID=your_resend_audience_id_optional
DISABLE_EMAILS=false  # Set to true to disable all email sending (useful for load testing)

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Stripe Configuration
STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID_MONTHLY=price_monthly_id_from_stripe
STRIPE_PRICE_ID_ANNUAL=price_annual_id_from_stripe
STRIPE_SUCCESS_URL=https://yourapp.com/subscription?status=success
STRIPE_CANCEL_URL=https://yourapp.com/subscription?status=cancel

# RevenueCat Configuration
REVENUECAT_API_KEY=api_key
REVENUECAT_WEBHOOK_AUTHORIZATION=secret

# Complete legacy Stripe/RevenueCat rollback surface. Production must set this
# explicitly; switching it off removes checkout, restore, redirects, webhooks,
# and legacy webhook workers together at the IAP-only cutover.
LEGACY_PROVIDER_WEBHOOKS_ENABLED=true

# Native App Store IAP (disabled until every value below is configured)
STORE_IAP_ENABLED=false
# Server-selected client environment. Production must use production; a
# separate nonproduction backend uses sandbox for StoreKit/Play test purchases.
STORE_IAP_CLIENT_ENVIRONMENT=sandbox
# Stable 32-byte HMAC key and versioned 32-byte AES keys, all base64 encoded.
STORE_EVIDENCE_LOOKUP_KEY_BASE64=
STORE_EVIDENCE_ACTIVE_KEY_VERSION=1
STORE_EVIDENCE_ENCRYPTION_KEYS_JSON={"1":"base64-encoded-32-byte-key"}

# Apple App Store Server API and Notifications V2
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_BUNDLE_ID=com.example.app
APPLE_IAP_APP_APPLE_ID=
APPLE_IAP_PRIVATE_KEY_BASE64=
# JSON array of base64-encoded DER Apple root CA certificates.
APPLE_IAP_ROOT_CERTIFICATES_BASE64_JSON=[]
APPLE_IAP_PRODUCTS_JSON={"com.example.premium.monthly":{"entitlement":"premium","billingPeriod":"monthly"}}

# Google Play Developer API and authenticated Pub/Sub push
# Credentials use Application Default Credentials (for local development,
# GOOGLE_APPLICATION_CREDENTIALS may point to an untracked service-account file).
GOOGLE_PLAY_PACKAGE_NAME=com.example.app
GOOGLE_PLAY_PRODUCTS_JSON={"premium-monthly":{"entitlement":"premium","billingPeriod":"monthly"}}
GOOGLE_PUBSUB_PUSH_AUDIENCE=https://api.example.com/webhook/google-play/rtdn
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=pubsub-push@example.iam.gserviceaccount.com
GOOGLE_PUBSUB_TOPIC=projects/example/topics/play-rtdn
GOOGLE_PUBSUB_SUBSCRIPTION=projects/example/subscriptions/play-rtdn-push
GOOGLE_PUBSUB_DEAD_LETTER_TOPIC=projects/example/topics/play-rtdn-dead-letter
GOOGLE_PUBSUB_DEAD_LETTER_SUBSCRIPTION=projects/example/subscriptions/play-rtdn-dead-letter
GOOGLE_PUBSUB_MAX_DELIVERY_ATTEMPTS=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=100

# Application Configuration
ENV=development
# Optional in nonproduction. Production overrides must be 10 or greater.
BCRYPT_COST=10
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For/X-Real-IP.
# Production must configure this or explicitly set DIRECT_CLIENT_TRAFFIC=true.
# Never use a zero-prefix network such as 0.0.0.0/0, 203.0.113.7/0, or ::/0.
TRUSTED_PROXY_CIDRS=
DIRECT_CLIENT_TRAFFIC=false
# Exact browser origins; production accepts HTTPS origins only and never reflects arbitrary values.
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:8081
# Production requires at least 32 non-placeholder bytes while static admin/worker routes are enabled.
STATIC_AUTHENTICATION=
RESET_PASSWORD_LINK=https://yourapp.com/reset-password
PORT=3000
DISABLE_PREPARED_STATEMENTS=false

# Expo Push Notifications (optional)
EXPO_PUSH_ACCESS_TOKEN=your_expo_push_access_token

# Monitoring Configuration
SENTRY_DSN=your_sentry_dsn_here
