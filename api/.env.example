# Database Configuration (POSTGRES_* are required for Docker)
# DATABASE_URL should point to the direct database server (used by workers).
DATABASE_URL=postgresql://user:pass@localhost:5432/decorebator?sslmode=disable
# PGBOUNCER_DATABASE_URL is optional and used by the API server when set.
PGBOUNCER_DATABASE_URL=
POSTGRES_USER=decorebator
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=decorebator
POSTGRES_PORT=5432

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_BUCKET=decorebator

# JWT Configuration
JWT_KEY=your_jwt_secret_here
JWT_SECRET=your_jwt_secret_here

# Email Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
SEND_GRID_RESET_PASSWORD_TEMPLATE_ID=your_template_id
SEND_GRID_WELCOME_TEMPLATE_ID=your_template_id
DISABLE_EMAILS=false  # Set to true to disable all email sending (useful for load testing)

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# Stripe Configuration
STRIPE_API_KEY=your_stripe_api_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID_MONTHLY=price_monthly_id_from_stripe
STRIPE_PRICE_ID_ANNUAL=price_annual_id_from_stripe
STRIPE_SUCCESS_URL=https://yourapp.com/subscription?status=success
STRIPE_CANCEL_URL=https://yourapp.com/subscription?status=cancel

# RevenueCat Configuration
REVENUECAT_API_KEY=api_key
REVENUECAT_WEBHOOK_AUTHORIZATION=secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=100

# Application Configuration
ENV=development
STATIC_AUTHENTICATION=your_static_auth_token
RESET_PASSWORD_LINK=https://yourapp.com/reset-password
PORT=3000
DISABLE_PREPARED_STATEMENTS=false

# Expo Push Notifications (optional)
EXPO_PUSH_ACCESS_TOKEN=your_expo_push_access_token

# Monitoring Configuration
SENTRY_DSN=your_sentry_dsn_here
