### Decorebator Analytics API Documentation
### 
### This file documents all analytics endpoints for the Decorebator API
### All endpoints require authentication via JWT token
###

# Login to get JWT token
# @name loginRequest
POST http://localhost:3000/auth/login
Content-Type: application/json

{
  "email": "test@example.com", 
  "password": "password123"
}

@authToken = {{loginRequest.response.headers.Authorization}}

###

##################################################
# PROGRESS SUMMARY ANALYTICS
##################################################

### Get Progress Summary (All Wordlists)
# Returns overview statistics for all user wordlists
# Response: Array of wordlist progress data with totals, mastery stats, streaks
GET http://localhost:3000/analytics/progress-summary
Authorization: {{authToken}}

###

##################################################
# WORDLIST-SPECIFIC ANALYTICS
##################################################

### Get Wordlist Overview Stats
# Returns comprehensive dashboard statistics for a specific wordlist
# Includes: total words, mastery, streaks, today's activity, accuracy
GET http://localhost:3000/analytics/wordlists/1/overview
Authorization: {{authToken}}

###

### Get Word Mastery Analytics
# Returns detailed mastery data for each word in the wordlist
# Includes: mastery level, accuracy, streak count, highest box, last seen
GET http://localhost:3000/analytics/wordlists/1/mastery
Authorization: {{authToken}}

###

### Get Learning Progress
# Returns daily learning progress over time
# Query params: days (1-365, default: 30)
GET http://localhost:3000/analytics/wordlists/1/progress?days=30
Authorization: {{authToken}}

###

### Get Learning Progress (7 days)
GET http://localhost:3000/analytics/wordlists/1/progress?days=7
Authorization: {{authToken}}

###

### Get Learning Progress (Custom range)
GET http://localhost:3000/analytics/wordlists/1/progress?days=90
Authorization: {{authToken}}

###

##################################################
# QUIZ PERFORMANCE ANALYTICS
##################################################

### Get Quiz Type Performance
# Returns performance metrics grouped by quiz type
# Includes: success rate, average response time, total attempts
GET http://localhost:3000/analytics/wordlists/1/quiz-performance
Authorization: {{authToken}}

###

##################################################
# LEITNER BOX DISTRIBUTION ANALYTICS  
##################################################

### Get Current Box Distribution
# Returns current distribution of words across Leitner boxes (1-7)
GET http://localhost:3000/analytics/wordlists/1/current-distribution
Authorization: {{authToken}}

###

### Get Box Distribution History
# Returns historical snapshots of box distribution over time
# Query params: days (1-90, default: 30)
GET http://localhost:3000/analytics/wordlists/1/box-distribution?days=30
Authorization: {{authToken}}

###

### Get Box Distribution History (7 days)
GET http://localhost:3000/analytics/wordlists/1/box-distribution?days=7
Authorization: {{authToken}}

###

##################################################
# PRACTICE TIME ANALYTICS
##################################################

### Get Practice Time Analytics
# Returns daily practice time and quiz count
# Query params: days (1-30, default: 7)
# Response includes filtered response times (200ms-30s range)
GET http://localhost:3000/analytics/wordlists/1/practice-time?days=7
Authorization: {{authToken}}

###

### Get Practice Time (30 days)
GET http://localhost:3000/analytics/wordlists/1/practice-time?days=30
Authorization: {{authToken}}

###

### Get Practice Time (1 day)
GET http://localhost:3000/analytics/wordlists/1/practice-time?days=1
Authorization: {{authToken}}

###

##################################################
# ERROR HANDLING EXAMPLES
##################################################

### Invalid Wordlist ID (404)
GET http://localhost:3000/analytics/wordlists/999999/mastery
Authorization: {{authToken}}

###

### Invalid Wordlist ID Format (400)  
GET http://localhost:3000/analytics/wordlists/invalid/mastery
Authorization: {{authToken}}

###

### Unauthorized Access (401)
GET http://localhost:3000/analytics/wordlists/1/mastery

###

### Invalid Days Parameter (defaults to valid range)
GET http://localhost:3000/analytics/wordlists/1/progress?days=invalid
Authorization: {{authToken}}

###

### Days Parameter Too Large (clamped to maximum)
GET http://localhost:3000/analytics/wordlists/1/practice-time?days=100
Authorization: {{authToken}}

###

