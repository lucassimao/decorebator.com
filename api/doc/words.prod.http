@email="abc@gmail.com"
@password= "12345"


### Creating user
POST http://localhost:3000/users
content-type: application/json

{
"FirstName":"Test 1",
"LastName":"xpto",
"Email": {{email}},
"Password": {{password}}
}

### Login
# @name loginRequest
POST https://dolphin-app-3u25d.ondigitalocean.app/decorebator-com-api2/login
content-type: application/json

{
"Email": {{email}},
"Password": {{password}}
}

@authToken = {{loginRequest.response.headers.authorization}}

### Listing wordlists
# @name wordlistRequest
GET https://dolphin-app-3u25d.ondigitalocean.app/decorebator-com-api2/wordlists
authorization: {{authToken}}


### Creating wordlist
# @name wordlistRequest
POST http://localhost:3000/wordlists
authorization: {{authToken}}

{
"Name":"tests",
"description":"tests only"
}

@wordlistId = {{wordlistRequest.response.body.id}} 
@wordlistId = 34

### Creating word
POST https://dolphin-app-3u25d.ondigitalocean.app/decorebator-com-api2/wordlists/{{wordlistId}}/words
authorization: {{authToken}}

{
 "Name":"Slip up"  
}



### Generating a quiz
POST http://localhost:3000/wordlists/{{wordlistId}}/quizzes
authorization: {{authToken}}

{
}

### Saving quiz result
PATCH http://localhost:3000/wordlists/{{wordlistId}}/quizzes
authorization: {{authToken}}

{
    "success": true,
    "id":30
}