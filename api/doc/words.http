@email="lsimaocosta@gmail.com"
@password= "12345"


### Creating user
POST http://localhost:3000/users
content-type: application/json

{
"FirstName":"Lucas",
"LastName":"Simao",
"Email": {{email}},
"Password": {{password}}
}

### Login
# @name loginRequest
POST http://localhost:3000/login
content-type: application/json

{
"Email": {{email}},
"Password": {{password}}
}

@authToken = {{loginRequest.response.headers.Authorization}}

### Get wordlists
GET http://localhost:3000/wordlists
authorization: {{authToken}}


### Next quiz 
POST http://localhost:3000/wordlists/7/quizzes
authorization: {{authToken}}




### Creating wordlist
# @name wordlistRequest
POST http://localhost:3000/wordlists
authorization: {{authToken}}

{
"Name":"Deep Utopia",
"LanguageCode":"en"
}

@wordlistId = {{wordlistRequest.response.body.id}} 

### Creating word
POST http://localhost:3000/wordlists/{{wordlistId}}/words
authorization: {{authToken}}

{
 "Name":"wherefore"  
}



### Generating a quiz
POST http://localhost:3000/wordlists/{{wordlistId}}/quizzes
authorization: {{authToken}}

{
}

### Saving quiz result
PATCH http://localhost:3000/wordlists/{{wordlistId}}/quizzes
authorization: {{authToken}}

{
    "success": true,
    "id":2
}