# Decorebator API Test Environment Configuration
# Copy this file to .env.test and modify as needed

# Database Configuration
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_pass
POSTGRES_DB=decorebator_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_URL=postgres://test_user:test_pass@localhost:5433/decorebator_test?sslmode=disable
TEST_DATABASE_URL=postgres://test_user:test_pass@localhost:5433/decorebator_test?sslmode=disable

# MinIO Configuration (S3-compatible storage)
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=testuser
MINIO_SECRET_KEY=testpass123
MINIO_USE_SSL=false
MINIO_BUCKET=decorebator-test
MINIO_LEGACY_BUCKETS=
MINIO_PORT=9009
MINIO_PUBLIC_BASE_URL=

# Redis Configuration
REDIS_URL=redis://localhost:6380

# Test Configuration
TEST_MODE=true
# Access tokens are environment-bound even in the local integration harness.
ENV=test
JWT_KEY=test-jwt-secret-key-for-testing-only-change-in-production
RESET_PASSWORD_PRIVATE_KEY=test-reset-password-key-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:8081
STATIC_AUTHENTICATION=test-static-authentication-32-bytes

# External API Keys (these are mock keys for testing)
OPENAI_API_KEY=test-openai-key-mock
STRIPE_API_KEY=test-stripe-key-mock
STRIPE_WEBHOOK_SECRET=test-stripe-webhook-secret
STRIPE_SUCCESS_URL=https://example.invalid/subscription/success
STRIPE_CANCEL_URL=https://example.invalid/subscription/cancel
STRIPE_PRICE_ID_MONTHLY=price_test_monthly
STRIPE_PRICE_ID_ANNUAL=price_test_annual
RESEND_API_KEY=test-resend-key-mock
REVENUECAT_API_KEY=your_revenuecat_api_key
REVENUECAT_WEBHOOK_AUTHORIZATION=your_webhook_authorization_token

# Feature Flags for Testing
DISABLE_WORKERS=true         # Disable background workers in tests
DISABLE_WEBHOOKS=true        # Disable webhook processing in tests
DISABLE_RATE_LIMITING=false  # Keep rate limiting for testing
DISABLE_EMAIL_SENDING=true   # Disable actual email sending

# Test-specific Configuration
MAX_TEST_DURATION=300        # Maximum test duration in seconds
TEST_LOG_LEVEL=info          # Test logging level (debug, info, warn, error)
ENABLE_TEST_FIXTURES=true    # Enable loading of test fixtures

# Mock Server URLs (set by test framework)
MOCK_OPENAI_URL=http://localhost:8081
MOCK_STRIPE_URL=http://localhost:8082

# Performance Settings for Tests
DB_MAX_CONNECTIONS=5         # Limit DB connections for tests
DB_CONNECTION_TIMEOUT=10     # Connection timeout in seconds
HTTP_TIMEOUT=30              # HTTP request timeout in seconds

# Coverage and Quality Gates
COVERAGE_THRESHOLD_UNIT=70        # Minimum unit test coverage (%)
COVERAGE_THRESHOLD_INTEGRATION=80 # Minimum integration test coverage (%)
ENABLE_RACE_DETECTION=true        # Enable race condition detection
ENABLE_MEMORY_PROFILING=false     # Enable memory profiling in tests

# Debug Settings
ENABLE_SQL_LOGGING=false     # Log all SQL queries in tests
ENABLE_HTTP_LOGGING=false    # Log all HTTP requests/responses
ENABLE_MOCK_LOGGING=false    # Log mock service interactions
