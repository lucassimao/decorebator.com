FROM gcr.io/datadoghq/agent:7

# Core Datadog configuration (matching docker run command)
ENV DD_SITE="us5.datadoghq.com"
ENV DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true
ENV DD_ENV=prod
ENV DD_APM_ENABLED=true
ENV DD_APM_NON_LOCAL_TRAFFIC=true
ENV DD_APM_RECEIVER_SOCKET=/var/run/datadog/apm.socket
ENV DD_DOGSTATSD_SOCKET=/var/run/datadog/dsd.socket

# Create socket directory
RUN mkdir -p /var/run/datadog && chmod 755 /var/run/datadog

# Expose ports
EXPOSE 8126 8125